<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Crux.Payments.Stripe</RootNamespace>
    <AssemblyName>Crux.Payments.Stripe</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Crux Stripe payments: PaymentIntent (escrow), capture, refund, webhook verification, idempotency-first with Polly v8 resilience</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Crux.Kernel\Crux.Kernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Stripe.net" Version="51.2.0" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <PackageReference Include="Polly.RateLimiting" Version="8.6.6" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.4" />
  </ItemGroup>
</Project>
